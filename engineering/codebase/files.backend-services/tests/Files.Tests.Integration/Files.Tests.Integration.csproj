<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Integration tier — the Form 1 module wired as a consumer wires it (AddFiles) over a real, throwaway store whose
    schema the module's own migrations build, once per lane: a SQLite file (no Docker), and a PostgreSQL database.
    No HTTP.
  -->
  <ItemGroup>
    <PackageReference Include="WoW2.Sdk.Beta.Be.Testing.Data" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\Module\WoW.Two.Sdk.Beta.Be.Files.Module.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The lanes every DB-touching tier shares (tests/Shared/Lanes): SQLite in process, PostgreSQL in one Testcontainers
       container per assembly, reported skipped while Docker is unreachable (FilesLaneTestFramework). -->
  <ItemGroup>
    <Compile Include="..\Shared\Lanes\*.cs" LinkBase="Lanes" />
    <AssemblyAttribute Include="Xunit.TestFrameworkAttribute">
      <_Parameter1>Files.Tests.Lanes.FilesLaneTestFramework</_Parameter1>
      <_Parameter2>$(AssemblyName)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
